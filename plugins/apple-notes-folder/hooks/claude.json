{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/hook.js\" --client claude"
          }
        ]
      },
      {
        "matcher": "mcp__plugin_apple-notes-folder_apple-notes-folder__notes_create|mcp__plugin_apple-notes-folder_apple-notes-folder__notes_append|mcp__plugin_apple-notes-folder_apple-notes-folder__notes_update",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/hook.js\" --client claude"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/hook.js\" --client claude"
          }
        ]
      }
    ]
  }
}
