{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/dist/hook.js\" --client codex"
          }
        ]
      },
      {
        "matcher": "mcp__apple_notes_folder__notes_create|mcp__apple_notes_folder__notes_append|mcp__apple_notes_folder__notes_update",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/dist/hook.js\" --client codex"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/dist/hook.js\" --client codex"
          }
        ]
      }
    ]
  }
}
